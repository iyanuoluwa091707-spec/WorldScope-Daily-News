rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test document used at boot
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Global reusable security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for User profiles, preferences and subscription status
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 254 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             data.updatedAt is string && data.updatedAt.size() <= 50 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 600000)) &&
             (!('savedArticles' in data) || (data.savedArticles is list && data.savedArticles.size() <= 200)) &&
             (!('subscribedNewsletters' in data) || (data.subscribedNewsletters is list && data.subscribedNewsletters.size() <= 50)) &&
             (!('subscriptionTier' in data) || (data.subscriptionTier is string && data.subscriptionTier in ['basic', 'premium', 'enterprise'])) &&
             (!('subscriptionStatus' in data) || (data.subscriptionStatus is string && data.subscriptionStatus in ['active', 'inactive', 'trial', 'canceled'])) &&
             (!('subscriptionExpiry' in data) || (data.subscriptionExpiry is string && data.subscriptionExpiry.size() <= 60)) &&
             (!('subscribedAt' in data) || (data.subscribedAt is string && data.subscribedAt.size() <= 60));
    }

    // User profile, private preferences, and verified subscription status
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // PII protection: prevent user directory scraping
      
      allow create: if isSignedIn() && 
                       isValidId(userId) && 
                       request.auth.uid == userId && 
                       isValidUser(incoming());

      allow update: if isSignedIn() && 
                       isValidId(userId) && 
                       request.auth.uid == userId && 
                       isValidUser(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 
                         'photoURL', 
                         'savedArticles', 
                         'subscribedNewsletters', 
                         'subscriptionTier', 
                         'subscriptionStatus', 
                         'subscriptionExpiry', 
                         'subscribedAt', 
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && 
                       isValidId(userId) && 
                       request.auth.uid == userId;
    }

    // Validation Blueprint for Article Likes
    function isValidLike(data) {
      return data.keys().hasAll(['id', 'articleId', 'userId', 'createdAt']) &&
             data.keys().size() <= 6 &&
             data.id is string && data.id.size() <= 128 &&
             data.articleId is string && data.articleId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('userName' in data) || (data.userName is string && data.userName.size() <= 100));
    }

    // Article Likes: authenticated users only can like and unlike
    match /articleLikes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                       isValidId(likeId) && 
                       isValidLike(incoming()) && 
                       request.auth.uid == incoming().userId && 
                       likeId == incoming().id;
      allow delete: if isSignedIn() && 
                       isValidId(likeId) && 
                       request.auth.uid == existing().userId;
      allow update: if false;
    }

    // Validation Blueprint for Article Comments
    function isValidComment(data) {
      return data.keys().hasAll(['id', 'articleId', 'userId', 'userName', 'comment', 'createdAt']) &&
             data.keys().size() <= 9 &&
             data.id is string && data.id.size() <= 128 &&
             data.articleId is string && data.articleId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userId == request.auth.uid &&
             data.userName is string && data.userName.size() <= 100 &&
             data.comment is string && data.comment.size() >= 1 && data.comment.size() <= 1500 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!('userLocation' in data) || (data.userLocation is string && data.userLocation.size() <= 100)) &&
             (!('upvotes' in data) || (data.upvotes is number));
    }

    // Article Comments: public read, but strictly authenticated create/delete
    match /articleComments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && 
                       isValidId(commentId) && 
                       isValidComment(incoming()) && 
                       request.auth.uid == incoming().userId && 
                       commentId == incoming().id;
      allow update: if isSignedIn() && 
                       isValidId(commentId) && 
                       request.auth.uid == existing().userId && 
                       isValidComment(incoming()) && 
                       incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'upvotes']);
      allow delete: if isSignedIn() && 
                       isValidId(commentId) && 
                       request.auth.uid == existing().userId;
    }

    // Public Advertiser Inquiries Submission
    match /adInquiries/{inquiryId} {
      allow create: if isValidId(inquiryId) && 
                       incoming().keys().hasAll(['id', 'companyName', 'email', 'submittedAt']) &&
                       incoming().companyName is string && incoming().companyName.size() <= 120 &&
                       incoming().email is string && incoming().email.size() <= 254;
      allow read, update, delete: if false;
    }
  }
}
