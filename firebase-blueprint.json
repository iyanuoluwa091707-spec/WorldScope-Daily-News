{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered WorldScope Daily user profile with preferences and subscriptions",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth unique identifier matching document ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User chosen or Google display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account registration"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last profile or preferences update"
        },
        "savedArticles": {
          "type": "array",
          "description": "List of bookmarked article identifiers"
        },
        "subscribedNewsletters": {
          "type": "array",
          "description": "List of subscribed newsletter identifiers"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile data, reading list bookmarks, and newsletter subscriptions"
    }
  }
}
