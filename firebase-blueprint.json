{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered WorldScope Daily user profile with preferences, subscriptions, and payment tier",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth unique identifier matching document ID"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "User chosen or Google display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "User profile photo URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account registration"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last profile or preferences update"
        },
        "savedArticles": {
          "type": "array",
          "description": "List of bookmarked article identifiers"
        },
        "subscribedNewsletters": {
          "type": "array",
          "description": "List of subscribed newsletter identifiers"
        },
        "subscriptionTier": {
          "type": "string",
          "enum": ["basic", "premium", "enterprise"],
          "description": "Active subscription tier"
        },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "inactive", "trial", "canceled"],
          "description": "State of user subscription"
        },
        "subscriptionExpiry": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration date of active subscription"
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when subscription was purchased"
        }
      },
      "required": ["uid", "email", "displayName", "createdAt", "updatedAt"]
    },
    "ArticleLike": {
      "title": "ArticleLike",
      "description": "User like record for an article or editorial post",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique like identifier composed of articleId_userId"
        },
        "articleId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the liked article"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the authenticated user who liked the post"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the user who liked"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the like was created"
        }
      },
      "required": ["id", "articleId", "userId", "createdAt"]
    },
    "ArticleComment": {
      "title": "ArticleComment",
      "description": "Reader discussion comment on an article",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique comment identifier"
        },
        "articleId": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the article being commented on"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of the authenticated author"
        },
        "userName": {
          "type": "string",
          "maxLength": 100,
          "description": "Display name of the commenter"
        },
        "userLocation": {
          "type": "string",
          "maxLength": 100,
          "description": "Location provided by the commenter"
        },
        "comment": {
          "type": "string",
          "maxLength": 1500,
          "description": "Text body of the comment"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the comment was posted"
        },
        "upvotes": {
          "type": "number",
          "description": "Number of upvotes received"
        }
      },
      "required": ["id", "articleId", "userId", "userName", "comment", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Stores user profile data, reading list bookmarks, newsletter subscriptions, and premium status"
    },
    "/articleLikes/{likeId}": {
      "schema": {
        "$ref": "#/entities/ArticleLike"
      },
      "description": "Stores article like records linked to authenticated user IDs"
    },
    "/articleComments/{commentId}": {
      "schema": {
        "$ref": "#/entities/ArticleComment"
      },
      "description": "Stores reader comments and discussion threads tied to articles and authenticated authors"
    }
  }
}
